# Mailjet SMTP relay
SMTP_HOST=in-v3.mailjet.com
SMTP_PORT=587
SMTP_USERNAME=your-mailjet-api-key
SMTP_PASSWORD=your-mailjet-secret-key
SMTP_ENCRYPTION=tls
SMTP_TIMEOUT=15
# Optional: set these separately if you do not want newsletter sync to reuse SMTP credentials.
# MAILJET_API_KEY=your-mailjet-api-key
# MAILJET_API_SECRET=your-mailjet-secret-key
MAILJET_NEWSLETTER_LIST_ID=123456
